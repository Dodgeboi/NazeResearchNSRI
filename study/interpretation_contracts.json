{
  "version": 1,
  "limits": "Retrospective, explicitly encoded claims. Does not parse unrestricted prose; source schemas and translations still require human review.",
  "sources": {
    "endpoints": {
      "path": "data/interpretation/endpoint_by_stage_profile.csv",
      "units": {
        "k1_minus_k4_pp": "percentage_points",
        "trials": "executions",
        "scenarios": "scenarios"
      }
    },
    "frontiers": {
      "path": "data/interpretation/endpoint_frontier_sensitivity.csv",
