        "jaccard_vs_k4": "fraction"
      }
    },
    "points": {
      "path": "data/interpretation/frontier_point_counts.csv",
      "units": {
        "full_frontier": "candidates",
        "omitted_efficient": "candidates"
      }
    },
    "contrasts": {
      "path": "data/interpretation/baseline_contrasts.csv",
      "units": {
        "mean_hours_saved": "weighted_service_hours",
        "simultaneous_lower": "weighted_service_hours"
      }
    }
  },
  "current": [
